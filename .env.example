JWT_SECRET=
JWT_ISSUER=rescuesync-cloud  # Identifica a Cloud como emisor del token. Se guarda en el campo iss.
JWT_AUDIENCE=rescuesync-cloud # Permite usar el token en Cloud, por ejemplo para /ongs/registro.
JWT_BACKEND_AUDIENCE=rescuesync-backend # Permite usar ese mismo token en las rutas protegidas del backend. Épico.
POSTGRES_PASSWORD=
DATABASE_URL=
# Para Compose: postgresql+psycopg://cloud:<password-codificado>@postgres:5432/cloud
# Para ejecución local: usar el host y puerto de una base PostgreSQL disponible.
USUARIO_RESCUESYNC=
PASSWORD_RESCUESYNC=
